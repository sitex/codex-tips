+use super::*;
+use crate::chatwidget::UserMessage;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn successful_turn_submission_clears_suggestion_and_cancels_request() -> Result<()> {
+    const TEST_STACK_SIZE_BYTES: usize = 8 * 1024 * 1024;
+
+    std::thread::Builder::new()
+        .name("next-prompt-submission".to_string())
+        .stack_size(TEST_STACK_SIZE_BYTES)
+        .spawn(|| {
+            let runtime = tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()?;
+            runtime.block_on(async {
+                let (mut app, _app_event_rx, mut op_rx) = make_test_app_with_channels().await;
+                let mut tui = crate::tui::test_support::make_test_tui()?;
+                let mut app_server =
+                    Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+                let started = app_server.start_thread(&app.config).await?;
+                app.enqueue_primary_thread_session(started.session, started.turns)
+                    .await?;
+                app.request_next_prompt_suggestion(&app_server);
+                assert!(app.pending_next_prompt_suggestion.is_some());
+                app.chat_widget
+                    .set_next_prompt_suggestion(Some("run the tests".to_string()));
+                app.chat_widget
+                    .restore_user_message_to_composer(UserMessage::from("new prompt"));
+
+                app.chat_widget
+                    .handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+                let op = next_user_turn_op(&mut op_rx);
+                let generation_before_submission = app.next_prompt_suggestion_generation;
+                assert_eq!(
+                    app.chat_widget.next_prompt_suggestion(),
+                    Some("run the tests")
+                );
+                assert!(!app.chat_widget.can_show_next_prompt_suggestion());
+
+                Box::pin(app.handle_event(&mut tui, &mut app_server, AppEvent::CodexOp(op)))
+                    .await?;
+
+                assert!(app.chat_widget.next_prompt_suggestion().is_none());
+                assert!(app.pending_next_prompt_suggestion.is_none());
+                assert!(app.next_prompt_suggestion_generation > generation_before_submission);
+                app_server.shutdown().await?;
+                Ok(())
+            })
+        })?
+        .join()
+        .expect("next prompt submission test thread")
+}
