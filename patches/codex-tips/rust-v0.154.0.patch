+#[tokio::test]
+async fn turn_started_invalidates_older_suggestion_generation() -> Result<()> {
+    let mut app = make_test_app().await;
+    let thread_id = ThreadId::new();
+    app.thread_event_channels
+        .insert(thread_id, ThreadEventChannel::new(/*capacity*/ 2));
+    app.activate_thread_channel(thread_id).await;
+    app.next_prompt_suggestion_generation = 1;
+    app.chat_widget
+        .set_next_prompt_suggestion(Some("old suggestion".to_string()));
+    app.enqueue_thread_notification(thread_id, turn_started_notification(thread_id, "turn-1"))
+        .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+
+    app.drain_active_thread_events(&mut tui).await?;
+    app.handle_next_prompt_suggestion_ready(
+        /*generation*/ 1,
+        thread_id,
+        /*latency_ms*/ 0,
+        Ok(Some("stale suggestion".to_string())),
+    );
+
+    assert!(app.chat_widget.next_prompt_suggestion().is_none());
+    Ok(())
+}
+
+#[tokio::test]
+async fn startup_drain_requests_suggestion_after_first_completed_turn() -> Result<()> {
+    // Given: the first active thread completes while startup drains its queued events.
+    let (mut app, mut app_event_rx, _op_rx) = make_test_app_with_channels().await;
+    while app_event_rx.try_recv().is_ok() {}
+    let thread_id = ThreadId::new();
+    app.thread_event_channels
+        .insert(thread_id, ThreadEventChannel::new(/*capacity*/ 2));
+    app.activate_thread_channel(thread_id).await;
+    for event in [
+        turn_started_notification(thread_id, "turn-1"),
+        turn_completed_notification(thread_id, "turn-1", TurnStatus::Completed),
+    ] {
+        app.enqueue_thread_notification(thread_id, event).await?;
+    }
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+
+    // When: startup drains the first turn instead of the foreground event branch.
+    app.drain_active_thread_events(&mut tui).await?;
+
+    // Then: the normal UI event path must still request the next-prompt suggestion.
+    assert!(
+        std::iter::from_fn(|| app_event_rx.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::RequestNextPromptSuggestion)),
+        "startup drain dropped the next-prompt suggestion request"
+    );
+    Ok(())
+}
