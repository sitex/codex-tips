diff --git a/codex-rs/core/src/session/turn_context.rs b/codex-rs/core/src/session/turn_context.rs
index 8df4f1c..92e5931 100644
--- a/codex-rs/core/src/session/turn_context.rs
+++ b/codex-rs/core/src/session/turn_context.rs
@@ -1098,6 +1098,75 @@ impl Session {
         .await
     }
 
+    /// Builds an ephemeral turn context without turn-start side effects.
+    ///
+    /// Hidden read-only work such as next-prompt prediction needs the current
+    /// model/provider/environment settings, but must not load plugins or skills,
+    /// enrich Git context, or mutate stored per-turn extension state.
+    pub(crate) async fn new_lightweight_turn(&self) -> Arc<TurnContext> {
+        let session_configuration = self.default_turn_configuration().await;
+        let turn_environments = self.services.turn_environments.snapshot().await;
+        let primary_turn_environment = turn_environments.primary();
