@@ -0,0 +1,43 @@
+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+
+const NEXT_PROMPT_SUGGESTION_PROMPT: &str = r#"[NEXT INPUT PREDICTION]
+
+Predict one short input that the user is likely to type next into Codex.
+
+Base the prediction only on the visible conversation. Continue the user's stated intent,
+language, and writing style. Prefer a concrete continuation that is already implied by the
+conversation. Return no text when several next actions are equally plausible, when the user
+needs to review an error, or when the task has no clear continuation.
+
+Do not speak as Codex, evaluate the result, introduce a new goal, ask a question, or combine
+multiple actions. Do not predict input involving credentials, private data, harmful actions,
+or security-sensitive operations.
+
+Output one line of 2 to 12 words with no quotes, label, punctuation, or explanation. An empty
+response is valid."#;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct NextPromptSuggestionInstructions;
+
+impl ContextualUserFragment for NextPromptSuggestionInstructions {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("next_prompt.suggestion_instructions".to_string())
+    }
+
+    fn role(&self) -> &'static str {
+        "user"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<next_prompt_suggestion>", "</next_prompt_suggestion>")
+    }
+
+    fn body(&self) -> String {
+        format!("\n{NEXT_PROMPT_SUGGESTION_PROMPT}\n")
+    }
+}
