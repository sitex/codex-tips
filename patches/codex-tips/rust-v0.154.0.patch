diff --git a/codex-rs/core/src/next_prompt_suggestion.rs b/codex-rs/core/src/next_prompt_suggestion.rs
new file mode 100644
index 0000000..9382f3f
--- /dev/null
+++ b/codex-rs/core/src/next_prompt_suggestion.rs
@@ -0,0 +1,263 @@
+//! Samples a hidden next-prompt prediction from an already-loaded session.
+//!
+//! The sample reuses a bounded tail of prompt-visible history, adds one synthetic
+//! user instruction, and never mutates the real conversation. Callers should
+//! treat `None` as the normal result whenever the conversation is not at a safe,
+//! stable boundary or the model elects to stay silent.
+
+use crate::TurnContext;
+use crate::client_common::Prompt;
+use crate::client_common::ResponseEvent;
+use crate::context::ContextualUserFragment;
+use crate::context::NextPromptSuggestionInstructions;
+use crate::responses_metadata::CodexResponsesRequestKind;
+use crate::session::session::Session;
+use codex_async_utils::OrCancelExt;
+use codex_protocol::openai_models::ModelPreset;
+use codex_protocol::openai_models::ReasoningEffort;
+use futures::StreamExt;
+use std::time::Duration;
+use std::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+#[path = "next_prompt_suggestion_history.rs"]
+mod history;
+use history::HistorySnapshot;
+use history::assistant_output_text;
+use history::bounded_recent_prompt_history;
+use history::has_unpaired_tool_flow;
+use history::session_history_matches_snapshot;
+use history::session_is_idle_for_suggestion;
+use history::suggestion_prompt_fits_context_window;
+
+#[cfg(test)]
+#[path = "next_prompt_suggestion_tests.rs"]
+mod tests;
+
+const NEXT_PROMPT_SUGGESTION_MAX_HISTORY_TOKENS: usize = 4_096;
+const NEXT_PROMPT_SUGGESTION_MAX_OUTPUT_TOKENS: u64 = 32;
+const NEXT_PROMPT_SUGGESTION_SAMPLE_TIMEOUT: Duration = Duration::from_secs(/*secs*/ 8);
+
+pub(crate) async fn suggest_next_prompt(
+    sess: &Session,
+    cancellation_token: CancellationToken,
+) -> Option<String> {
+    if cancellation_token.is_cancelled() || !session_is_idle_for_suggestion(sess).await {
+        return None;
+    }
+
+    let started_at = Instant::now();
+    let turn_context = sess.new_lightweight_turn().await;
+    let suggestion_reasoning_effort = fast_suggestion_reasoning_effort(&turn_context);
+
+    let history = sess.clone_history().await;
+    let history_snapshot = HistorySnapshot::from_history(&history);
+    if has_unpaired_tool_flow(history.raw_items()) {
+        tracing::debug!("next prompt suggestion skipped for incomplete tool flow");
+        return None;
+    }
+    let prompt_input = history.for_prompt(&turn_context.model_info().input_modalities);
+    let Some(mut prompt_input) =
+        bounded_recent_prompt_history(prompt_input, NEXT_PROMPT_SUGGESTION_MAX_HISTORY_TOKENS)
+    else {
+        tracing::debug!("next prompt suggestion skipped without stable recent history");
+        return None;
+    };
+    prompt_input.push(ContextualUserFragment::into(
+        NextPromptSuggestionInstructions,
+    ));
+
+    let prompt = Prompt {
+        input: prompt_input,
+        tools: Default::default(),
+        parallel_tool_calls: false,
+        base_instructions: sess.get_base_instructions().await,
+        output_schema: None,
+        output_schema_strict: true,
+        cyber_access_program: turn_context.cyber_access_program.clone(),
+        max_output_tokens: Some(NEXT_PROMPT_SUGGESTION_MAX_OUTPUT_TOKENS),
+    };
+    if !suggestion_prompt_fits_context_window(&prompt, &turn_context)
+        || !session_is_idle_for_suggestion(sess).await
+    {
+        return None;
+    }
+
+    let responses_metadata = turn_context.turn_metadata_state.to_responses_metadata(
+        sess.installation_id.clone(),
+        sess.current_window_id().await,
+        CodexResponsesRequestKind::Turn,
+    );
+    let mut client_session = sess.services.model_client.new_isolated_session();
+    let inference_trace = codex_rollout_trace::InferenceTraceContext::disabled();
+    let sample_deadline = tokio::time::sleep(NEXT_PROMPT_SUGGESTION_SAMPLE_TIMEOUT);
+    tokio::pin!(sample_deadline);
+    let stream = client_session
+        .stream(
+            &prompt,
+            turn_context.model_info(),
+            &turn_context.session_telemetry,
+            suggestion_reasoning_effort.clone(),
+            turn_context.reasoning_summary(),
+            turn_context.config.service_tier.clone(),
+            &responses_metadata,
+            &inference_trace,
+        )
+        .or_cancel(&cancellation_token);
+    let mut stream = match tokio::select! {
+        result = stream => result,
+        _ = &mut sample_deadline => {
+            tracing::debug!("next prompt suggestion timed out before sampling started");
+            return None;
+        }
+    } {
+        Ok(Ok(stream)) => stream,
+        Ok(Err(err)) => {
+            tracing::debug!(error = ?err, "next prompt suggestion failed before sampling started");
+            return None;
+        }
+        Err(codex_async_utils::CancelErr::Cancelled) => return None,
+    };
+
+    let mut streamed_text = String::new();
+    let mut completed_text = None;
+    loop {
+        if !session_is_idle_for_suggestion(sess).await {
+            client_session.reset_websocket_session();
+            return None;
+        }
+        let Some(event) = (tokio::select! {
+            event = stream.next().or_cancel(&cancellation_token) => match event {
+                Ok(event) => event,
+                Err(codex_async_utils::CancelErr::Cancelled) => {
+                    client_session.reset_websocket_session();
+                    return None;
+                }
+            },
+            _ = tokio::time::sleep(Duration::from_millis(/*millis*/ 100)) => continue,
+            _ = &mut sample_deadline => {
+                tracing::debug!("next prompt suggestion timed out while sampling");
+                client_session.reset_websocket_session();
+                return None;
+            },
+        }) else {
+            client_session.reset_websocket_session();
+            return None;
+        };
+        match event {
+            Ok(ResponseEvent::OutputItemDone(item)) => {
+                if let Some(text) = assistant_output_text(&item) {
+                    completed_text = Some(text);
+                }
+            }
+            Ok(ResponseEvent::OutputTextDelta(delta)) => streamed_text.push_str(&delta),
+            Ok(ResponseEvent::RateLimits(snapshot)) => {
+                sess.record_rate_limits_info(snapshot).await;
+            }
+            Ok(ResponseEvent::Completed { .. }) => break,
+            Ok(_) => {}
+            Err(err) => {
+                tracing::debug!(error = ?err, "next prompt suggestion stream failed");
+                client_session.reset_websocket_session();
+                return None;
+            }
+        }
+    }
+    client_session.reset_websocket_session();
+    if cancellation_token.is_cancelled()
+        || !session_history_matches_snapshot(sess, history_snapshot).await
+        || !session_is_idle_for_suggestion(sess).await
+    {
+        return None;
+    }
+
+    let suggestion =
+        filter_next_prompt_suggestion(completed_text.as_deref().unwrap_or(streamed_text.as_str()));
+    tracing::debug!(
+        latency_ms = u64::try_from(started_at.elapsed().as_millis()).unwrap_or(u64::MAX),
+        model = %turn_context.model_info().slug,
+        effort = ?suggestion_reasoning_effort,
+        has_suggestion = suggestion.is_some(),
+        "next prompt suggestion sampled"
+    );
+    suggestion
+}
+
+fn fast_suggestion_reasoning_effort(turn_context: &TurnContext) -> Option<ReasoningEffort> {
+    let fallback = turn_context.reasoning_effort().cloned();
+    let Some(preset) = turn_context
+        .available_models
+        .iter()
+        .find(|preset| preset.model == turn_context.model_info().slug)
+    else {
+        return fallback;
+    };
+    preferred_suggestion_effort(preset, fallback)
+}
+
+fn preferred_suggestion_effort(
+    preset: &ModelPreset,
+    fallback: Option<ReasoningEffort>,
+) -> Option<ReasoningEffort> {
+    for effort in [ReasoningEffort::Minimal, ReasoningEffort::Low] {
+        if preset
+            .supported_reasoning_efforts
+            .iter()
+            .any(|supported| supported.effort == effort)
+        {
+            return Some(effort);
+        }
+    }
+    fallback
+}
+
+fn filter_next_prompt_suggestion(raw: &str) -> Option<String> {
+    let raw = raw.trim();
+    let suggestion = raw.split_whitespace().collect::<Vec<_>>().join(" ");
+    if suggestion.is_empty()
+        || raw.chars().any(|ch| matches!(ch, '\n' | '\r' | '\t'))
+        || suggestion.len() >= 100
+        || suggestion.chars().any(|ch| matches!(ch, '?' | '!'))
+        || suggestion.ends_with('.')
+        || suggestion.chars().any(|ch| matches!(ch, '`' | '*'))
+        || suggestion.starts_with("- ")
+    {
+        return None;
+    }
+
+    let lower = suggestion.to_ascii_lowercase();
+    if matches!(
+        lower.as_str(),
+        "done" | "no suggestion" | "stay silent" | "silence"
+    ) || lower.starts_with("suggestion:")
+        || lower.starts_with("next prompt:")
+        || is_wrapped_meta(&suggestion)
+        || is_wrapped_quote(&suggestion)
+        || starts_with_any(&lower, &["looks good", "thanks", "thank you"])
+        || starts_with_any(&lower, &["let me", "i'll", "i will", "here's"])
+    {
+        return None;
+    }
+
+    let word_count = suggestion.split_whitespace().count();
+    if word_count > 12
+        || (word_count < 2 && !matches!(lower.as_str(), "yes" | "commit" | "push" | "continue"))
+    {
+        return None;
+    }
+    Some(suggestion)
+}
+
+fn is_wrapped_meta(suggestion: &str) -> bool {
+    (suggestion.starts_with('(') && suggestion.ends_with(')'))
+        || (suggestion.starts_with('[') && suggestion.ends_with(']'))
+}
+
+fn is_wrapped_quote(suggestion: &str) -> bool {
+    (suggestion.starts_with('"') && suggestion.ends_with('"'))
+        || (suggestion.starts_with('\'') && suggestion.ends_with('\''))
+}
+
+fn starts_with_any(value: &str, prefixes: &[&str]) -> bool {
+    prefixes.iter().any(|prefix| value.starts_with(prefix))
+}
diff --git a/codex-rs/core/src/next_prompt_suggestion_history.rs b/codex-rs/core/src/next_prompt_suggestion_history.rs
new file mode 100644
index 0000000..0644d81
--- /dev/null
+++ b/codex-rs/core/src/next_prompt_suggestion_history.rs
@@ -0,0 +1,181 @@
+use crate::TurnContext;
+use crate::client_common::Prompt;
+use crate::context_manager::ContextManager;
+use crate::session::session::Session;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::ResponseItem;
+use codex_utils_output_truncation::approx_token_count;
+use std::collections::HashSet;
+
+const NEXT_PROMPT_SUGGESTION_TOKEN_HEADROOM: i64 = 1_024;
+
+#[derive(Clone, Copy)]
+pub(super) struct HistorySnapshot {
+    version: u64,
+    len: usize,
+}
+
+impl HistorySnapshot {
+    pub(super) fn from_history(history: &ContextManager) -> Self {
+        Self {
+            version: history.history_version(),
+            len: history.raw_items().len(),
+        }
+    }
+}
+
+pub(super) async fn session_is_idle_for_suggestion(sess: &Session) -> bool {
+    sess.active_turn.lock().await.is_none() && sess.conversation.running_state().await.is_none()
+}
+
+pub(super) async fn session_history_matches_snapshot(
+    sess: &Session,
+    snapshot: HistorySnapshot,
+) -> bool {
+    let history = sess.clone_history().await;
+    history.history_version() == snapshot.version && history.raw_items().len() == snapshot.len
+}
+
+pub(super) fn suggestion_prompt_fits_context_window(
+    prompt: &Prompt,
+    turn_context: &TurnContext,
+) -> bool {
+    let Some(model_context_window) = turn_context.model_context_window() else {
+        return false;
+    };
+    let Ok(input) = serde_json::to_string(&prompt.input) else {
+        return false;
+    };
+    let estimated_token_count = approx_token_count(&prompt.base_instructions.text)
+        .saturating_add(approx_token_count(&input));
+    let estimated_token_count = i64::try_from(estimated_token_count).unwrap_or(i64::MAX);
+    estimated_token_count
+        < model_context_window.saturating_sub(NEXT_PROMPT_SUGGESTION_TOKEN_HEADROOM)
+}
+
+pub(super) fn bounded_recent_prompt_history(
+    items: Vec<ResponseItem>,
+    max_tokens: usize,
+) -> Option<Vec<ResponseItem>> {
+    let items = items
+        .into_iter()
+        .filter(|item| !matches!(item, ResponseItem::Reasoning { .. }))
+        .collect::<Vec<_>>();
+    let mut remaining_tokens = max_tokens;
+    let mut keep_from = items.len();
+    for (index, item) in items.iter().enumerate().rev() {
+        let serialized = serde_json::to_string(item).ok()?;
+        let item_tokens = approx_token_count(&serialized);
+        if item_tokens > remaining_tokens {
+            break;
+        }
+        keep_from = index;
+        remaining_tokens = remaining_tokens.saturating_sub(item_tokens);
+    }
+    let bounded = items[keep_from..].to_vec();
+    if bounded.is_empty()
+        || has_unpaired_tool_flow(&bounded)
+        || !history_ends_at_assistant_response(&bounded)
+        || final_assistant_message_count(&bounded) < 1
+    {
+        return None;
+    }
+    Some(bounded)
+}
+
+fn history_ends_at_assistant_response(items: &[ResponseItem]) -> bool {
+    matches!(
+        items.last(),
+        Some(ResponseItem::Message { role, phase, .. })
+            if role == "assistant" && !matches!(phase, Some(MessagePhase::Commentary))
+    )
+}
+
+fn final_assistant_message_count(items: &[ResponseItem]) -> usize {
+    items
+        .iter()
+        .filter(|item| {
+            matches!(
+                item,
+                ResponseItem::Message { role, phase, .. }
+                    if role == "assistant" && !matches!(phase, Some(MessagePhase::Commentary))
+            )
+        })
+        .count()
+}
+
+pub(super) fn assistant_output_text(item: &ResponseItem) -> Option<String> {
+    let ResponseItem::Message { role, content, .. } = item else {
+        return None;
+    };
+    if role != "assistant" {
+        return None;
+    }
+    let text = content
+        .iter()
+        .filter_map(|content| match content {
+            ContentItem::OutputText { text } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<String>();
+    (!text.is_empty()).then_some(text)
+}
+
+pub(super) fn has_unpaired_tool_flow<'a>(
+    items: impl IntoIterator<Item = &'a ResponseItem>,
+) -> bool {
+    let mut function_calls = HashSet::new();
+    let mut function_outputs = HashSet::new();
+    let mut custom_tool_calls = HashSet::new();
+    let mut custom_tool_outputs = HashSet::new();
+    let mut tool_search_calls = HashSet::new();
+    let mut tool_search_outputs = HashSet::new();
+    let mut client_tool_search_outputs = HashSet::new();
+
+    for item in items {
+        match item {
+            ResponseItem::FunctionCall { call_id, .. }
+            | ResponseItem::LocalShellCall {
+                call_id: Some(call_id),
+                ..
+            } => {
+                function_calls.insert(call_id.clone());
+            }
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                ..
+            } => {
+                function_outputs.insert(call_id.clone());
+            }
+            ResponseItem::CustomToolCall { call_id, .. } => {
+                custom_tool_calls.insert(call_id.clone());
+            }
+            ResponseItem::CustomToolCallOutput { call_id, .. } => {
+                custom_tool_outputs.insert(call_id.clone());
+            }
+            ResponseItem::ToolSearchCall {
+                call_id: Some(call_id),
+                ..
+            } => {
+                tool_search_calls.insert(call_id.clone());
+            }
+            ResponseItem::ToolSearchOutput {
+                call_id: Some(call_id),
+                execution,
+                ..
+            } => {
+                tool_search_outputs.insert(call_id.clone());
+                if execution != "server" {
+                    client_tool_search_outputs.insert(call_id.clone());
+                }
+            }
+            _ => {}
+        }
+    }
+
+    function_calls != function_outputs
+        || custom_tool_calls != custom_tool_outputs
+        || !tool_search_calls.is_subset(&tool_search_outputs)
+        || !client_tool_search_outputs.is_subset(&tool_search_calls)
+}
diff --git a/codex-rs/core/src/next_prompt_suggestion_tests.rs b/codex-rs/core/src/next_prompt_suggestion_tests.rs
new file mode 100644
index 0000000..6e47cd3
--- /dev/null
+++ b/codex-rs/core/src/next_prompt_suggestion_tests.rs
@@ -0,0 +1,126 @@
+use super::bounded_recent_prompt_history;
+use super::filter_next_prompt_suggestion;
+use super::has_unpaired_tool_flow;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ReasoningItemContent;
+use codex_protocol::models::ReasoningItemReasoningSummary;
+use codex_protocol::models::ResponseItem;
+use pretty_assertions::assert_eq;
+
+fn message(role: &str, text: &str) -> ResponseItem {
+    ResponseItem::Message {
+        id: None,
+        role: role.to_string(),
+        content: vec![if role == "assistant" {
+            ContentItem::OutputText {
+                text: text.to_string(),
+            }
+        } else {
+            ContentItem::InputText {
+                text: text.to_string(),
+            }
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+#[test]
+fn filter_keeps_composer_safe_prompts() {
+    for (suggestion, expected) in [
+        ("run the tests", "run the tests"),
+        (" run the tests\n", "run the tests"),
+        ("commit", "commit"),
+        ("продолжай реализацию", "продолжай реализацию"),
+    ] {
+        assert_eq!(
+            filter_next_prompt_suggestion(suggestion),
+            Some(expected.to_string())
+        );
+    }
+}
+
+#[test]
+fn filter_rejects_non_prompt_outputs() {
+    for suggestion in [
+        "",
+        "done",
+        "Suggestion: run the tests",
+        "looks good",
+        "thanks",
+        "let me run tests",
+        "what about tests?",
+        "run tests.",
+        "\"run the tests\"",
+        "run\ntests",
+        "continue with every possible next step in this project and explain every detail now",
+    ] {
+        assert_eq!(filter_next_prompt_suggestion(suggestion), None);
+    }
+}
+
+#[test]
+fn bounded_history_accepts_one_completed_assistant_message() {
+    // Given one fully completed user/assistant turn.
+    let completed_turn = vec![message("user", "task"), message("assistant", "answer")];
+
+    // When the history is bounded for a next-prompt suggestion.
+    let bounded = bounded_recent_prompt_history(completed_turn.clone(), /*max_tokens*/ 256);
+
+    // Then that first completed turn is enough context for sampling.
+    assert_eq!(bounded, Some(completed_turn));
+}
+
+#[test]
+fn bounded_history_ignores_hidden_reasoning_when_preserving_completed_turns() {
+    let visible_history = vec![
+        message("user", "first task"),
+        message("assistant", "first answer"),
+        message("user", "second task"),
+        message("assistant", "second answer"),
+    ];
+    let mut history_with_reasoning = visible_history.clone();
+    history_with_reasoning.insert(
+        2,
+        ResponseItem::Reasoning {
+            id: None,
+            summary: vec![ReasoningItemReasoningSummary::SummaryText {
+                text: "summary".to_string(),
+            }],
+            content: Some(vec![ReasoningItemContent::ReasoningText {
+                text: "hidden reasoning ".repeat(5_000),
+            }]),
+            encrypted_content: None,
+            internal_chat_message_metadata_passthrough: None,
+        },
+    );
+
+    assert_eq!(
+        bounded_recent_prompt_history(history_with_reasoning, /*max_tokens*/ 256),
+        Some(visible_history)
+    );
+}
+
+#[test]
+fn incomplete_tool_flow_is_suppressed() {
+    let call = ResponseItem::CustomToolCall {
+        id: None,
+        status: None,
+        call_id: "call-1".to_string(),
+        name: "exec".to_string(),
+        namespace: None,
+        input: "{}".to_string(),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    assert!(has_unpaired_tool_flow([&call]));
+
+    let output = ResponseItem::CustomToolCallOutput {
+        id: None,
+        call_id: "call-1".to_string(),
+        name: Some("exec".to_string()),
+        output: FunctionCallOutputPayload::from_text("done".to_string()),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    assert!(!has_unpaired_tool_flow([&call, &output]));
+}
