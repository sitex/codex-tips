+#[tokio::test]
+async fn stale_generation_is_ignored() {
+    let mut app = make_test_app().await;
+    let thread_id = ThreadId::new();
+    app.active_thread_id = Some(thread_id);
+    app.next_prompt_suggestion_generation = 2;
+
+    app.handle_next_prompt_suggestion_ready(
+        /*generation*/ 1,
+        thread_id,
+        /*latency_ms*/ 0,
+        Ok(Some("run the tests".to_string())),
+    );
+
+    assert!(app.chat_widget.next_prompt_suggestion().is_none());
+}
+
+#[tokio::test]
+async fn matching_suggestion_received_with_draft_is_revealed_after_clear() {
+    let mut app = make_test_app().await;
+    let thread_id = ThreadId::new();
+    app.active_thread_id = Some(thread_id);
+    app.next_prompt_suggestion_generation = 1;
+    app.chat_widget.apply_external_edit("draft".to_string());
+
+    app.handle_next_prompt_suggestion_ready(
+        /*generation*/ 1,
+        thread_id,
+        /*latency_ms*/ 0,
+        Ok(Some("run the tests".to_string())),
+    );
+
+    assert_eq!(
+        app.chat_widget.next_prompt_suggestion(),
+        Some("run the tests")
+    );
+    assert!(!app.chat_widget.can_show_next_prompt_suggestion());
+    assert!(!render_bottom_popup(&app.chat_widget, /*width*/ 80).contains("run the tests"));
+
+    app.chat_widget.apply_external_edit(String::new());
+
+    assert!(app.chat_widget.can_show_next_prompt_suggestion());
+    assert!(render_bottom_popup(&app.chat_widget, /*width*/ 80).contains("run the tests"));
+}
