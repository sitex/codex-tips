+use super::*;
+use pretty_assertions::assert_eq;
+
+async fn input_harness(app: &App) -> Result<(AppServerSession, tui::Tui)> {
+    let app_server =
+        crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref()).await?;
+    Ok((app_server, crate::tui::test_support::make_test_tui()?))
+}
+
+#[tokio::test]
+async fn tab_and_right_accept_without_submitting() -> Result<()> {
+    for code in [KeyCode::Tab, KeyCode::Right] {
+        let (mut app, _app_event_rx, mut op_rx) = make_test_app_with_channels().await;
+        app.chat_widget
+            .set_next_prompt_suggestion(Some("run the tests".to_string()));
+        let (mut app_server, mut tui) = input_harness(&app).await?;
+
+        app.handle_key_event(
+            &mut tui,
+            &mut app_server,
+            KeyEvent::new(code, KeyModifiers::NONE),
+        )
+        .await;
+
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            "run the tests"
+        );
+        assert!(app.chat_widget.next_prompt_suggestion().is_none());
+        assert!(op_rx.try_recv().is_err());
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn enter_does_not_accept_or_submit_ghost_text() -> Result<()> {
+    let (mut app, _app_event_rx, mut op_rx) = make_test_app_with_channels().await;
+    app.chat_widget
+        .set_next_prompt_suggestion(Some("run the tests".to_string()));
+    let (mut app_server, mut tui) = input_harness(&app).await?;
+
+    app.handle_key_event(
+        &mut tui,
+        &mut app_server,
+        KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE),
+    )
+    .await;
+
+    assert!(app.chat_widget.composer_text_with_pending().is_empty());
+    assert!(app.chat_widget.composer_is_empty());
+    assert_eq!(
+        app.chat_widget.next_prompt_suggestion(),
+        Some("run the tests")
+    );
+    assert!(op_rx.try_recv().is_err());
+    Ok(())
+}
+
+#[tokio::test]
+async fn manual_typing_hides_ghost_text_without_discarding_it() -> Result<()> {
+    let (mut app, _app_event_rx, _op_rx) = make_test_app_with_channels().await;
+    app.chat_widget
+        .set_next_prompt_suggestion(Some("run the tests".to_string()));
