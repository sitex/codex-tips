+async fn suggestion_acceptance_keys_follow_composer_emptiness() {
+    let mut app = make_test_app().await;
+    app.chat_widget
+        .set_next_prompt_suggestion(Some("run the tests".to_string()));
+    app.chat_widget.apply_external_edit("draft".to_string());
+
+    for code in [KeyCode::Tab, KeyCode::Right] {
+        assert!(
+            !app.next_prompt_suggestion_key_should_accept(KeyEvent::new(code, KeyModifiers::NONE,))
+        );
+    }
+
+    app.chat_widget.apply_external_edit(String::new());
+    for code in [KeyCode::Tab, KeyCode::Right] {
+        assert!(
+            app.next_prompt_suggestion_key_should_accept(KeyEvent::new(code, KeyModifiers::NONE,))
+        );
+    }
+}
