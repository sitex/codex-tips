#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'install-codex-tips: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: install-codex-tips [--force]

Build and install the codex-tips patch for the currently installed Codex CLI.

Environment overrides:
  CODEX_TIPS_CODEX          Official Codex command used for version detection
  CODEX_TIPS_CODE_MODE_HOST Companion binary to install (default: discover beside Codex)
  CODEX_TIPS_RUNTIME_PACKAGE Official platform package root (default: auto-detect)
  CODEX_TIPS_UPSTREAM       Codex Git repository (default: OpenAI/codex)
  CODEX_TIPS_CACHE_DIR      Git source cache (default: ~/.cache/codex-tips)
  CODEX_TIPS_TARGET_DIR     Cargo target directory (default: /tmp/codex-tips-target-<version>)
  CODEX_TIPS_INSTALL_ROOT   Permanent binary root (default: ~/.local/lib/codex-tips)
  CODEX_TIPS_LINK           Stable binary link (default: ~/.local/bin/codex-tips)
  CODEX_TIPS_ALIAS          Patched `codex` command (default: ~/.local/bin/codex)
EOF
}

force=false
case "${1:-}" in
  '') ;;
  --force) force=true ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
[[ $# -le 1 ]] || die 'expected at most one argument'

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
codex_alias=${CODEX_TIPS_ALIAS:-$HOME/.local/bin/codex}

resolve_path() {
  local path=$1 target

  case "$path" in
    /*) ;;
    *) path="$PWD/$path" ;;
  esac
  while [[ -L $path ]]; do
    target=$(readlink "$path") || return
    case "$target" in
      /*) path=$target ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$path")" && pwd)" "$(basename "$path")"
}

discover_official_codex() {
  local candidate fallback resolved
  fallback=

  while IFS= read -r candidate; do
    [[ $candidate == "$codex_alias" ]] && continue
    [[ -n $fallback ]] || fallback=$candidate
    resolved=$(resolve_path "$candidate") || continue
    case "$resolved" in
      */@openai/codex/bin/codex.js)
        printf '%s\n' "$candidate"
        return
        ;;
    esac
  done < <(type -a -P codex 2>/dev/null | awk '!seen[$0]++')
  [[ -n $fallback ]] || return 1
  printf '%s\n' "$fallback"
}

if [[ -n ${CODEX_TIPS_CODEX:-} ]]; then
  codex_command=$CODEX_TIPS_CODEX
else
  codex_command=$(discover_official_codex) \
    || die 'official Codex command not found; set CODEX_TIPS_CODEX'
fi
command -v "$codex_command" >/dev/null 2>&1 || die "Codex command not found: $codex_command"

codex_version_output=$("$codex_command" --version 2>/dev/null) \
  || die "failed to run '$codex_command --version'"
if [[ $codex_version_output =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
  codex_version=${BASH_REMATCH[1]}
else
  die "could not parse Codex version from: $codex_version_output"
fi
codex_tag="rust-v$codex_version"

patch_dir="$repo_root/patches/codex-tips"
patch_file="$patch_dir/$codex_tag.patch"
if [[ ! -f $patch_file ]]; then
  known_versions=
  for known_patch in "$patch_dir"/rust-v*.patch; do
    [[ -f $known_patch ]] || continue
    known_version=$(printf '%s\n' "$known_patch" | sed -E 's#^.*/rust-v([0-9]+\.[0-9]+\.[0-9]+)\.patch$#\1#')
    if [[ -n $known_versions ]]; then
      known_versions="$known_versions, $known_version"
    else
      known_versions=$known_version
    fi
  done
  [[ -n $known_versions ]] || die "no codex-tips patches found in $patch_dir"
  die "unsupported Codex version $codex_version; supported versions: $known_versions"
fi

case "$codex_tag" in
  rust-v0.152.0) expected_upstream_commit=316795b3cf2a45e90d121d9f46499d4658b2645c ;;
  *) die "missing trusted upstream commit for $codex_tag" ;;
esac

cache_dir=${CODEX_TIPS_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/codex-tips}
target_dir=${CODEX_TIPS_TARGET_DIR:-${TMPDIR:-/tmp}/codex-tips-target-$codex_version}
install_root=${CODEX_TIPS_INSTALL_ROOT:-$HOME/.local/lib/codex-tips}
installed_dir="$install_root/$codex_version"
installed_binary="$installed_dir/bin/codex"
installed_code_mode_host="$installed_dir/bin/codex-code-mode-host"
launcher_link=${CODEX_TIPS_LINK:-$HOME/.local/bin/codex-tips}

runtime_package_is_valid() {
  local root=$1

  [[ -f $root/codex-package.json \
    && -x $root/bin/codex \
    && -x $root/bin/codex-code-mode-host \
    && -d $root/codex-resources \
    && -d $root/codex-path ]]
}

find_runtime_package() {
  local candidate codex_entry count metadata package_root runtime_package

  if [[ -n ${CODEX_TIPS_RUNTIME_PACKAGE:-} ]]; then
    runtime_package=$(resolve_path "$CODEX_TIPS_RUNTIME_PACKAGE") \
      || die "failed to resolve runtime package: $CODEX_TIPS_RUNTIME_PACKAGE"
    runtime_package_is_valid "$runtime_package" \
      || die "invalid Codex runtime package: $runtime_package"
    printf '%s\n' "$runtime_package"
    return
  fi

  codex_entry=$(command -v "$codex_command")
  codex_entry=$(resolve_path "$codex_entry") \
    || die "failed to resolve Codex command: $codex_command"
  candidate=${codex_entry%/bin/codex}
  if [[ $candidate != "$codex_entry" ]] && runtime_package_is_valid "$candidate"; then
    printf '%s\n' "$candidate"
    return
  fi

  case "$codex_entry" in
    */bin/codex.js) package_root=${codex_entry%/bin/codex.js} ;;
    *) die "could not locate Codex runtime package; set CODEX_TIPS_RUNTIME_PACKAGE" ;;
  esac
  count=0
  while IFS= read -r metadata; do
    candidate=$(dirname "$metadata")
    runtime_package_is_valid "$candidate" || continue
    runtime_package=$candidate
    count=$((count + 1))
  done < <(find "$package_root" -type f -name codex-package.json -print)
  [[ $count -eq 1 ]] \
    || die "expected one Codex runtime package under $package_root, found $count; set CODEX_TIPS_RUNTIME_PACKAGE"
  printf '%s\n' "$runtime_package"
}

sync_runtime_support() {
  local component host_source runtime_package=$1

  if [[ -n ${CODEX_TIPS_CODE_MODE_HOST:-} ]]; then
    [[ -x $CODEX_TIPS_CODE_MODE_HOST ]] \
      || die "code-mode host is not executable: $CODEX_TIPS_CODE_MODE_HOST"
    host_source=$CODEX_TIPS_CODE_MODE_HOST
  else
    host_source="$runtime_package/bin/codex-code-mode-host"
  fi
  install -d "$installed_dir/bin"
  install -m 0755 "$host_source" "$installed_code_mode_host"
  install -m 0644 "$runtime_package/codex-package.json" "$installed_dir/codex-package.json"
  for component in codex-resources codex-path; do
    install -d "$installed_dir/$component"
    cp -R "$runtime_package/$component/." "$installed_dir/$component/"
  done
}

runtime_package=$(find_runtime_package)

install_launchers() {
  local alias_dir alias_tmp link_dir link_target link_tmp resolved_install_root

  link_dir=$(dirname "$launcher_link")
  install -d "$link_dir"
  resolved_install_root=$(resolve_path "$install_root")
  if [[ -e $launcher_link || -L $launcher_link ]]; then
    [[ -L $launcher_link ]] \
      || die "refusing to replace existing codex-tips command: $launcher_link"
    link_target=$(resolve_path "$launcher_link" 2>/dev/null || true)
    case "$link_target" in
      "$resolved_install_root"/*/codex | "$resolved_install_root"/*/bin/codex) ;;
      *) die "refusing to replace unmanaged codex-tips link: $launcher_link" ;;
    esac
  fi
  link_tmp="$link_dir/.codex-tips-link.$$"
  ln -s "$installed_binary" "$link_tmp"
  mv -f "$link_tmp" "$launcher_link"

  if [[ -e $codex_alias || -L $codex_alias ]]; then
    if [[ ! -L $codex_alias || $(readlink "$codex_alias") != "$launcher_link" ]]; then
      die "refusing to replace existing Codex command: $codex_alias"
    fi
  fi
  alias_dir=$(dirname "$codex_alias")
  install -d "$alias_dir"
  alias_tmp="$alias_dir/.codex-alias.$$"
  ln -s "$launcher_link" "$alias_tmp"
  mv -f "$alias_tmp" "$codex_alias"
  printf 'Installed patched Codex command: %s\n' "$codex_alias"
  printf '%s\n' "Restart existing Codex sessions; run \`hash -r\` in long-lived Bash shells before launching \`codex\`."
}

binary_matches_version() {
  local output
  output=$("$1" --version 2>/dev/null) || return 1
  [[ $output == *"$codex_version"* ]]
}

if [[ $force == false && -x $installed_binary ]] && binary_matches_version "$installed_binary"; then
  sync_runtime_support "$runtime_package"
  install_launchers
  printf 'codex-tips %s is already installed at %s\n' "$codex_version" "$installed_binary"
  "$launcher_link" --version
  exit 0
fi

upstream=${CODEX_TIPS_UPSTREAM:-https://github.com/openai/codex.git}
source_repo="$cache_dir/upstream.git"
install -d "$cache_dir"
if [[ ! -d $source_repo ]]; then
  git init --bare "$source_repo" >/dev/null
  git --git-dir="$source_repo" remote add origin "$upstream"
else
  current_upstream=$(git --git-dir="$source_repo" remote get-url origin 2>/dev/null || true)
  if [[ $current_upstream != "$upstream" ]]; then
    git --git-dir="$source_repo" remote set-url origin "$upstream"
  fi
fi

if ! git --git-dir="$source_repo" show-ref --verify --quiet "refs/tags/$codex_tag"; then
  printf 'Fetching Codex source tag %s...\n' "$codex_tag"
  git --git-dir="$source_repo" fetch --depth=1 origin \
    "refs/tags/$codex_tag:refs/tags/$codex_tag"
fi
actual_upstream_commit=$(git --git-dir="$source_repo" rev-parse "$codex_tag^{}")
[[ $actual_upstream_commit == "$expected_upstream_commit" ]] \
  || die "upstream tag $codex_tag resolved to untrusted commit $actual_upstream_commit"

checkout_root=$(mktemp -d "${TMPDIR:-/tmp}/codex-tips-source.XXXXXX")
checkout="$checkout_root/source"
cleanup() {
  local status=$?
  trap - EXIT
  if [[ -d $checkout ]]; then
    git --git-dir="$source_repo" worktree remove --force "$checkout" >/dev/null 2>&1 || true
  fi
  rmdir "$checkout_root" >/dev/null 2>&1 || true
  exit "$status"
}
trap cleanup EXIT

git --git-dir="$source_repo" worktree add --detach "$checkout" "$codex_tag" >/dev/null
printf 'Applying %s...\n' "$(basename "$patch_file")"
if ! git -C "$checkout" apply --3way "$patch_file"; then
  die "patch does not apply cleanly to $codex_tag; add a ported $codex_tag.patch"
fi

printf 'Building codex-tips %s...\n' "$codex_version"
env CARGO_TARGET_DIR="$target_dir" CARGO_INCREMENTAL=0 \
  cargo build --manifest-path "$checkout/codex-rs/Cargo.toml" -p codex-cli --release

built_binary="$target_dir/release/codex"
[[ -x $built_binary ]] || die "build finished without executable: $built_binary"
binary_matches_version "$built_binary" \
  || die "built binary version does not match $codex_version"

sync_runtime_support "$runtime_package"
staged_binary="$installed_dir/bin/.codex.$$"
install -m 0755 "$built_binary" "$staged_binary"
mv -f "$staged_binary" "$installed_binary"
install_launchers

printf 'Installed codex-tips %s at %s\n' "$codex_version" "$installed_binary"
"$launcher_link" --version
